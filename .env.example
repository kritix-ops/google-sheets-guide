# Auth.js
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Auth.js production URL (e.g. https://google-sheets-guide.vercel.app).
# Optional in v5; explicit for clarity on hosted deploys. Leave unset in dev.
AUTH_URL=

# Google OAuth (from Google Cloud Console → APIs & Services → Credentials)
# Authorized redirect URIs must include both:
#   http://localhost:3000/api/auth/callback/google         (local dev)
#   https://<production-url>/api/auth/callback/google      (hosted)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Bootstrap admins (comma-separated emails). These emails can sign in as
# admin when the `allowed_user` DB table contains no admin yet. After the
# first admin is seeded, the DB allowlist is authoritative and this var
# stops mattering (you manage the allowlist via the /admin/users UI).
# At first deploy you MUST set this or no one can sign in.
# Example: AUTH_INITIAL_ADMINS=info@flexelent.com,co-admin@example.com
AUTH_INITIAL_ADMINS=

# Deprecated (legacy). The env-var allowlist has been replaced by the
# `allowed_user` DB table. Setting this no longer affects sign-in. Remove
# from your Vercel env after confirming the new admin UI works.
AUTH_ALLOWED_EMAILS=

# Anthropic (Claude judge layer for open-ended grading)
ANTHROPIC_API_KEY=

# Database (libSQL / Turso).
# Local dev: leave both unset to fall back to a local file at .data/sheets-guide.db.
# Hosted: set both to the values from `turso db show <name> --url` and
# `turso db tokens create <name>`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
