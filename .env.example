# Auth.js
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Google OAuth (from Google Cloud Console → APIs & Services → Credentials)
# Authorized redirect URI must be: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Anthropic
ANTHROPIC_API_KEY=

# SQLite database file (optional override; default below)
# DATABASE_FILE=./.data/sheets-guide.db
